{
  "name": "workout-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "convex dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:import-compat": "vitest run src/lib/import-compat.test.ts",
    "sync:prod": "node scripts/sync-prod.mjs",
    "sync:prod:all": "node scripts/sync-prod.mjs --vercel",
    "sync:preview": "node scripts/sync-preview.mjs",
    "sync:preview:all": "node scripts/sync-preview.mjs --vercel",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@convex-dev/polar": "^0.9.2",
    "@polar-sh/sdk": "0.49.0",
    "convex": "^1.42.0",
    "convex-helpers": "^0.1.120"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^20",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.5",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^4.1.9"
  }
}
