// Copy this file to ios/Config/Secrets.xcconfig (gitignored) and fill in your values.
// Never commit Secrets.xcconfig.
//
// Clerk publishable key from Clerk Dashboard -> API Keys (pk_test_... or pk_live_...)
CLERK_PUBLISHABLE_KEY = pk_test_replace_me

// Convex HTTP actions host WITHOUT scheme (avoid // comments in xcconfig),
// e.g. happy-otter-123.convex.site
CONVEX_SITE_HOST = your-deployment.convex.site
