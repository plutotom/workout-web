{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"],
      "@backend/*": ["./backend/_generated/*"]
    }
  },
  "include": ["src/**/*.ts", "*.ts", "*.mts"],
  "exclude": ["node_modules", "backend", "scripts", "ios"]
}
