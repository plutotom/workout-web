diff --git a/ios/ExceptionCatcher.mm b/ios/ExceptionCatcher.mm
--- a/ios/ExceptionCatcher.mm
+++ b/ios/ExceptionCatcher.mm
@@ -15,3 +15,21 @@
         return nil;
     }
 }
+
+BOOL RNHealthKitCatchException(void (^ _Nonnull tryBlock)(void), NSError * _Nullable * _Nullable outError) {
+    if (outError) { *outError = nil; }
+    @try {
+        tryBlock();
+        return YES;
+    }
+    @catch (NSException *exception) {
+        if (outError) {
+            NSMutableDictionary *userInfo = [NSMutableDictionary dictionaryWithDictionary:exception.userInfo ?: @{}];
+            if (exception.reason) {
+                userInfo[NSLocalizedDescriptionKey] = exception.reason;
+            }
+            *outError = [NSError errorWithDomain:exception.name ?: @"NSException" code:0 userInfo:userInfo];
+        }
+        return NO;
+    }
+}
