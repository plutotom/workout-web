{
  "expo": {
    "name": "Workout",
    "slug": "workout-ios-v1",
    "scheme": "workout",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.isaiahproctor.workout.local",
      "appleTeamId": "3CVY7K9AJ6"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      "expo-file-system",
      "expo-sharing",
      "expo-notifications",
      "./plugins/strip-signing-capabilities.js"
    ]
  }
}
