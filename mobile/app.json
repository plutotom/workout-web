{
  "expo": {
    "name": "Grayed Lift",
    "slug": "workout-ios-v1",
    "scheme": "workout",
    "version": "0.1.12",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": {
        "light": "./assets/icon.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.isaiahproctor.workout.local",
      "appleTeamId": "3CVY7K9AJ6",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Grayed Lift reads your Apple Health workouts so you can import a run, ride, swim, walk, or other activity into your training log.",
        "NSHealthUpdateUsageDescription": "Grayed Lift can save workouts you finish in this app to Apple Health. Saving is off until you turn on export.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.private-cloud-compute": true
      },
      "buildNumber": "11"
    },
    "owner": "plutotom",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-updates",
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "expo-web-browser",
      "expo-file-system",
      "expo-sharing",
      "expo-notifications",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Grayed Lift reads your Apple Health workouts so you can import a run, ride, swim, walk, or other activity into your training log.",
          "NSHealthUpdateUsageDescription": "Grayed Lift can save workouts you finish in this app to Apple Health. Saving is off until you turn on export.",
          "background": true
        }
      ],
      "@bacons/apple-targets",
      "./plugins/strip-signing-capabilities.js",
      "./plugins/stable-react-native-path.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.isaiahproctor.workout.local.watchkitapp",
                  "targetName": "Watch",
                  "entitlements": {
                    "com.apple.developer.healthkit": true
                  }
                }
              ]
            }
          }
        },
        "projectId": "3fb28c80-26a9-4ff5-a609-8cbe2750466b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/3fb28c80-26a9-4ff5-a609-8cbe2750466b"
    },
    "android": {
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    }
  }
}
