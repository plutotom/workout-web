{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@app/*": ["app/*"],
      "@backend/*": ["../backend/_generated/*"],
      "@shared/*": ["../src/lib/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
