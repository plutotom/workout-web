# Mobile public config is injected by scripts/mobile.mjs from the worktree root:
#   .env.local                  — default (pnpm ios, pnpm dev:ios)
#   .env.mobile.preview         — physical device / preview backends (see .env.mobile.preview.example)
#   .env.mobile.production      — EAS / OTA production (see .env.mobile.production.example)
#
# Equivalent keys at the repo root (not in this folder):
#   NEXT_PUBLIC_CONVEX_URL
#   NEXT_PUBLIC_WORKOS_REDIRECT_URI  → EXPO_PUBLIC_WEB_URL uses this URL's origin
