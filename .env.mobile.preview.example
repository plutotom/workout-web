# Copy to .env.mobile.preview (gitignored). Used by pnpm ios:device:preview* — not by Next.js.
#
# Preview/staging URLs reachable from a physical iPhone (not 127.0.0.1).
# EXPO_PUBLIC_WEB_URL is derived from the redirect URI origin (mobile API + auth).

NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://your-preview-host.example/callback
