# Copy to .env.mobile.production (gitignored). Used by OTA / EAS production scripts.
# Must match production after `pnpm exec convex deploy` from the repo root.
#
# Keys mirror scripts/mobile.mjs (NEXT_PUBLIC_*) or set EXPO_PUBLIC_* directly.

NEXT_PUBLIC_CONVEX_URL=https://YOUR_PRODUCTION_DEPLOYMENT.convex.cloud
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://workout.plutotom.com/callback

# Or set Expo keys directly (EAS cloud builds can use expo.dev Environment variables instead):
# EXPO_PUBLIC_CONVEX_URL=https://YOUR_PRODUCTION_DEPLOYMENT.convex.cloud
# EXPO_PUBLIC_WEB_URL=https://workout.plutotom.com
